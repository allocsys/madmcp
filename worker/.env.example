# repo_map worker -- environment variables
#
# Deployed on Railway (see railway.toml + README.md). Set these as Railway
# service variables (Project -> repo-map-worker service -> Variables), not
# in a committed .env file.

# Neon Postgres connection string (pooled endpoint recommended). Must point
# at a database with `CREATE EXTENSION vector` run and src/db/schema.sql
# applied. Neon requires SSL -- src/db/client.js already sets
# ssl: { rejectUnauthorized: false }, so sslmode=require in the URL is fine.
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require

# Gemini API key(s), used for gemini-embedding-001 embeddings
# (src/embed/gemini.js). Output is truncated to 1536 dimensions via
# outputDimensionality to match the chunks.embedding vector(1536) column.
#
# Prefer GEMINI_API_KEYS: comma-separated list of keys (no spaces needed
# around commas, they're trimmed), e.g. GEMINI_API_KEYS=key-one,key-two.
# embedTexts() rotates across all configured keys per batch -- a 429 on one
# key records a short cooldown and falls back to the next; a bad/revoked
# key (401/403) falls back with no cooldown. Having more than one key from
# a different Google account/project is what actually helps here: rotation
# alone doesn't get you more quota if every key shares the same exhausted
# pool.
#
# GEMINI_API_KEY (singular) is still supported as a fallback for a
# single-key setup -- only read if GEMINI_API_KEYS is unset.
GEMINI_API_KEYS=key-one,key-two
# GEMINI_API_KEY=...

# Shared secret madmcp sends as `Authorization: Bearer <this value>` on
# every request (src/auth.js). Generate a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Set the SAME value as REPO_MAP_SHARED_SECRET on madmcp's own deployment
# (Vercel project env vars), alongside REPO_MAP_WORKER_URL pointing at this
# worker's public Railway domain.
REPO_MAP_SHARED_SECRET=

# PORT is injected automatically by Railway -- do not set it manually.
# server.js already reads process.env.PORT with an 8080 fallback for local
# dev (`npm run dev`).
