{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/*": false,
      "fix/*": false,
      "test/*": false,
      "chore/*": false,
      "feat/*": false,
      "bug/*": false,
      "debug/*": false
    }
  },
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  },
  "ignoreCommand": "bash -c '! git diff --name-only HEAD^ HEAD | grep -qvE \"^(.*\\.md|demo\\.html|test/.*|\\.github/.*)$\"'"
}
